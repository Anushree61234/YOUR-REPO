<%- include("../partials/head") %>

<%- include("../partials/navbar") %>

<body class="bg-gray-100 min-h-screen">

  <!-- Signup Section -->

  <section class="max-w-md mx-auto py-12 px-6">

```
<h1 class="text-4xl font-bold text-center mb-3">Sign Up</h1>

<p class="text-gray-600 text-center mb-10">
  Create an account to get started.
</p>

<div class="bg-white rounded-xl shadow-md p-8">

  <!-- Error Messages -->

  <%- include("../partials/errors") %>

  <form action="/signup" method="POST">

    <!-- First Name -->

    <div class="mb-5">

      <label for="firstName" class="block text-gray-700 font-semibold mb-2">
        First Name
      </label>

      <input
        type="text"
        id="firstName"
        name="firstName"
        placeholder="Enter your first name"
        value="<%= oldInput ? oldInput.firstName : '' %>"
        class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-red-500"
      >

    </div>


    <!-- Last Name -->

    <div class="mb-5">

      <label for="lastName" class="block text-gray-700 font-semibold mb-2">
        Last Name
      </label>

      <input
        type="text"
        id="lastName"
        name="lastName"
        placeholder="Enter your last name (optional)"
        value="<%= oldInput ? oldInput.lastName : '' %>"
        class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-red-500"
      >

    </div>


    <!-- Email -->

    <div class="mb-5">

      <label for="email" class="block text-gray-700 font-semibold mb-2">
        Email
      </label>

      <input
        type="email"
        id="email"
        name="email"
        placeholder="Enter your email"
        value="<%= oldInput ? oldInput.email : '' %>"
        class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-red-500"
      >

    </div>


    <!-- Password -->

    <div class="mb-5">

      <label for="password" class="block text-gray-700 font-semibold mb-2">
        Password
      </label>

      <input
        type="password"
        id="password"
        name="password"
        placeholder="Create a password"
        class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-red-500"
      >

    </div>


    <!-- Confirm Password -->

    <div class="mb-5">

      <label for="confirm_password" class="block text-gray-700 font-semibold mb-2">
        Confirm Password
      </label>

      <input
        type="password"
        id="confirm_password"
        name="confirm_password"
        placeholder="Confirm your password"
        class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-red-500"
      >

    </div>


    <!-- User Type -->

    <div class="mb-5">

      <label for="userType" class="block text-gray-700 font-semibold mb-2">
        User Type
      </label>

      <select
        id="userType"
        name="userType"
        class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-red-500"
      >

        <option value="">Select user type</option>

        <option
          value="guest"
          <%= oldInput && oldInput.userType === 'guest' ? 'selected' : '' %>
        >
          Guest
        </option>

        <option
          value="host"
          <%= oldInput && oldInput.userType === 'host' ? 'selected' : '' %>
        >
          Host
        </option>

      </select>

    </div>


    <!-- Terms and Conditions -->

    <div class="mb-6 flex items-center">

      <input
        type="checkbox"
        id="terms"
        name="termsAccepted"
        value="on"
        class="w-4 h-4 text-red-500 border-gray-300 rounded focus:ring-red-500"
      >

      <label for="terms" class="ml-2 text-gray-600">

        I agree to the

        <a href="#" class="text-red-500 font-semibold hover:underline">
          Terms and Conditions
        </a>

      </label>

    </div>


    <!-- Signup Button -->

    <button
      type="submit"
      class="w-full bg-red-500 text-white py-3 rounded-lg font-semibold hover:bg-red-600 transition"
    >
      Sign Up
    </button>

  </form>


  <p class="text-center text-gray-500 mt-6">

    Already have an account?

    <a href="/login" class="text-red-500 font-semibold hover:underline">
      Login
    </a>

  </p>

</div>
```

  </section>

</body>

</html>
