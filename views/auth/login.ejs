<%- include("../partials/head") %>

<%- include("../partials/navbar") %>

<body class="bg-gray-100 min-h-screen">

  <!-- Login Section -->

  <section class="max-w-md mx-auto py-12 px-6">

    <h1 class="text-4xl font-bold text-center mb-3">Login</h1>

    <p class="text-gray-600 text-center mb-10">
      Login to your account to continue.
    </p>

    <div class="bg-white rounded-xl shadow-md p-8">

      <%- include("../partials/errors") %>

      <form action="/login" method="POST">

        <!-- Email -->

        <div class="mb-5">
          <label for="email" class="block text-gray-700 font-semibold mb-2">
            Email
          </label>

          <input
            type="email"
            id="email"
            name="email"
            placeholder="Enter your email"
            required
            class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-red-500"
          >
        </div>

        <!-- Password -->

        <div class="mb-6">
          <label for="password" class="block text-gray-700 font-semibold mb-2">
            Password
          </label>

          <input
            type="password"
            id="password"
            name="password"
            placeholder="Enter your password"
            required
            class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-red-500"
          >
        </div>

        <!-- Login Button -->

        <button
          type="submit"
          class="w-full bg-red-500 text-white py-3 rounded-lg font-semibold hover:bg-red-600 transition"
        >
          Login
        </button>

      </form>

      <p class="text-center text-gray-500 mt-6">
        Don't have an account?
        <a href="/signup" class="text-red-500 font-semibold hover:underline">
          Sign Up
        </a>
      </p>

    </div>

  </section>

</body>

</html>