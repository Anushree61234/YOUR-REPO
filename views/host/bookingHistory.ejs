<%- include("../partials/head") %>
<%- include("../partials/navbar") %>

<body class="bg-gray-100 min-h-screen">

  <!-- Page Header -->
  <section class="max-w-6xl mx-auto px-6 pt-10 pb-6">
    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-4xl font-bold text-gray-900">Booking History</h1>
        <p class="text-gray-600 mt-2">View all bookings for your properties.</p>
      </div>
      <a href="/host/pending-bookings" class="px-6 py-3 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 transition font-semibold">
        ⏱ Pending Requests
      </a>
    </div>
  </section>

  <!-- Filter Tabs -->
  <section class="max-w-6xl mx-auto px-6 pb-8">
    <div class="flex gap-2 flex-wrap">
      <button class="filter-btn px-4 py-2 rounded-lg font-semibold transition bg-red-500 text-white active" data-status="all">
        All
      </button>
      <button class="filter-btn px-4 py-2 rounded-lg font-semibold transition bg-gray-200 text-gray-700 hover:bg-gray-300" data-status="approved">
        ✓ Approved
      </button>
      <button class="filter-btn px-4 py-2 rounded-lg font-semibold transition bg-gray-200 text-gray-700 hover:bg-gray-300" data-status="pending">
        ⏱ Pending
      </button>
      <button class="filter-btn px-4 py-2 rounded-lg font-semibold transition bg-gray-200 text-gray-700 hover:bg-gray-300" data-status="rejected">
        ✕ Rejected
      </button>
      <button class="filter-btn px-4 py-2 rounded-lg font-semibold transition bg-gray-200 text-gray-700 hover:bg-gray-300" data-status="cancelled">
        ✕ Cancelled
      </button>
    </div>
  </section>

  <!-- Main Content -->
  <section class="max-w-6xl mx-auto px-6 pb-12">

    <!-- No Bookings -->
    <% if (!bookings || bookings.length === 0) { %>

      <div class="bg-white rounded-xl shadow-lg p-12 text-center">
        <div class="text-5xl mb-4">📋</div>
        <h3 class="text-2xl font-bold text-gray-900 mb-2">No booking history</h3>
        <p class="text-gray-600">Your booking history will appear here once guests start booking.</p>
      </div>

    <% } else { %>

      <!-- Bookings List -->
      <div class="space-y-6">

        <% bookings.forEach(booking => { %>

          <div 
            class="booking-card bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition" 
            data-status="<%= booking.status %>"
          >

            <div class="md:flex">

              <!-- Image -->
              <div class="md:w-1/3">
                <img 
                  src="/<%= booking.homeId?.photo %>" 
                  alt="<%= booking.homeId?.houseName %>"
                  class="w-full h-64 md:h-full object-cover"
                  onerror="this.src='https://placehold.co/400x300?text=No+Image'"
                >
              </div>

              <!-- Content -->
              <div class="p-6 md:w-2/3">

                <!-- Header with Status -->
                <div class="flex justify-between items-start mb-4">
                  <div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-1">
                      <%= booking.homeId?.houseName %>
                    </h3>
                    <p class="text-gray-600 flex items-center gap-1">
                      📍 <%= booking.homeId?.location %>
                    </p>
                  </div>

                  <!-- Status Badge -->
                  <span class="px-4 py-2 rounded-full text-sm font-bold <%= 
                    booking.status === 'approved' ? 'bg-green-100 text-green-800' :
                    booking.status === 'pending' ? 'bg-yellow-100 text-yellow-800' :
                    booking.status === 'rejected' ? 'bg-red-100 text-red-800' :
                    'bg-gray-100 text-gray-800'
                  %>">
                    <%= booking.status === 'approved' ? '✓ Approved' : booking.status === 'pending' ? '⏱ Pending' : booking.status === 'rejected' ? '✕ Rejected' : '✕ Cancelled' %>
                  </span>
                </div>

                <!-- Guest Info -->
                <div class="bg-blue-50 p-3 rounded-lg mb-4">
                  <p class="text-xs text-blue-700 uppercase font-semibold mb-1">Guest</p>
                  <p class="font-semibold text-gray-900">
                    <%= booking.guestId?.firstName %> <%= booking.guestId?.lastName %>
                  </p>
                  <p class="text-sm text-gray-600"><%= booking.guestId?.email %></p>
                </div>

                <!-- Booking Details Grid -->
                <div class="grid grid-cols-2 md:grid-cols-5 gap-3 py-4 border-y border-gray-200 mb-4">

                  <div>
                    <p class="text-xs text-gray-600 uppercase font-semibold mb-1">Check-in</p>
                    <p class="font-semibold text-gray-900">
                      <%= new Date(booking.checkInDate).toLocaleDateString('en-IN', {day: '2-digit', month: 'short', year: '2-digit'}) %>
                    </p>
                  </div>

                  <div>
                    <p class="text-xs text-gray-600 uppercase font-semibold mb-1">Check-out</p>
                    <p class="font-semibold text-gray-900">
                      <%= new Date(booking.checkOutDate).toLocaleDateString('en-IN', {day: '2-digit', month: 'short', year: '2-digit'}) %>
                    </p>
                  </div>

                  <div>
                    <p class="text-xs text-gray-600 uppercase font-semibold mb-1">Nights</p>
                    <p class="font-semibold text-gray-900"><%= booking.numberOfNights %></p>
                  </div>

                  <div>
                    <p class="text-xs text-gray-600 uppercase font-semibold mb-1">Rate</p>
                    <p class="font-semibold text-gray-900">₹<%= booking.pricePerNight %></p>
                  </div>

                  <div class="bg-red-50 p-3 rounded-lg">
                    <p class="text-xs text-red-700 uppercase font-semibold mb-1">Total</p>
                    <p class="font-bold text-red-500 text-lg">₹<%= booking.totalPrice %></p>
                  </div>

                </div>

                <!-- Additional Info -->
                <div class="space-y-3">

                  <!-- Guest Message -->
                  <% if (booking.guestMessage) { %>
                    <div>
                      <p class="text-xs text-gray-600 uppercase font-semibold mb-1">Guest Note</p>
                      <p class="text-sm text-gray-700 italic">
                        "<%= booking.guestMessage.substring(0, 100) %><%= booking.guestMessage.length > 100 ? '...' : '' %>"
                      </p>
                    </div>
                  <% } %>

                  <!-- Rejection Reason -->
                  <% if (booking.hostRejectReason) { %>
                    <div class="bg-red-50 p-3 rounded-lg">
                      <p class="text-xs text-red-700 uppercase font-semibold mb-1">Rejection Reason</p>
                      <p class="text-sm text-red-700">
                        "<%= booking.hostRejectReason %>"
                      </p>
                    </div>
                  <% } %>

                  <!-- Request Date -->
                  <div>
                    <p class="text-xs text-gray-600 uppercase font-semibold mb-1">Requested On</p>
                    <p class="text-sm text-gray-700">
                      <%= new Date(booking.createdAt).toLocaleDateString('en-IN', {day: '2-digit', month: 'short', year: 'numeric'}) %>
                    </p>
                  </div>

                </div>

                <!-- Action Button -->
                <div class="mt-4 pt-4 border-t border-gray-200">
                  <a 
                    href="/homes/<%= booking.homeId?._id %>" 
                    class="inline-block px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition font-semibold text-sm"
                  >
                    View Home
                  </a>
                </div>

              </div>

            </div>

          </div>

        <% }); %>

      </div>

    <% } %>

  </section>

</body>

<!-- JavaScript for Filtering -->
<script>
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      // Update active button styling
      document.querySelectorAll('.filter-btn').forEach(b => {
        b.classList.remove('bg-red-500', 'text-white');
        b.classList.add('bg-gray-200', 'text-gray-700');
      });
      this.classList.add('bg-red-500', 'text-white');
      this.classList.remove('bg-gray-200', 'text-gray-700');

      // Filter bookings
      const selectedStatus = this.getAttribute('data-status');
      document.querySelectorAll('.booking-card').forEach(card => {
        const cardStatus = card.getAttribute('data-status');
        if (selectedStatus === 'all' || cardStatus === selectedStatus) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>

</html>
