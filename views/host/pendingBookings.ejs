<%- include("../partials/head") %>

<%
  // Safe defaults so the template never crashes if a variable isn't passed
  const messageList = locals.messages || [];
  const bookingList = locals.pendingBookings || [];

  const formatDate = function (d) {
    return new Date(d).toLocaleDateString('en-IN', {
      day: '2-digit',
      month: 'short'
    });
  };
%>

<body class="bg-gray-100 min-h-screen">

  <%- include("../partials/navbar") %>

  <!-- Page Header -->
  <section class="max-w-6xl mx-auto px-6 pt-10 pb-6">
    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-4xl font-bold text-gray-900">Pending Booking Requests</h1>
        <p class="text-gray-600 mt-2">Review and approve/reject booking requests from guests.</p>
      </div>
      <a href="/host/booking-history" class="px-6 py-3 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition font-semibold">
        View History
      </a>
    </div>
  </section>

  <!-- Main Content -->
  <section class="max-w-6xl mx-auto px-6 pb-12">

    <!-- Success/Error Messages -->
    <% messageList.forEach(function (msg) {
         const isSuccess = msg.type === 'success';
         const msgClasses = isSuccess
           ? 'bg-green-50 border border-green-200 text-green-800'
           : 'bg-red-50 border border-red-200 text-red-800';
    %>
      <div class="mb-6 p-4 rounded-lg <%= msgClasses %>">
        <p class="font-semibold"><%= isSuccess ? '✓ Success' : '✕ Error' %></p>
        <p class="text-sm"><%= msg.text %></p>
      </div>
    <% }); %>

    <% if (bookingList.length === 0) { %>

      <!-- No Pending Bookings -->
      <div class="bg-white rounded-xl shadow-lg p-12 text-center">
        <div class="text-5xl mb-4">✓</div>
        <h3 class="text-2xl font-bold text-gray-900 mb-2">All caught up!</h3>
        <p class="text-gray-600">No pending booking requests. All requests have been reviewed.</p>
      </div>

    <% } else { %>

      <!-- Pending Bookings List -->
      <div class="space-y-6">

        <% bookingList.forEach(function (booking) {
             const home = booking.homeId || {};
             const guest = booking.guestId || {};
        %>

          <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition border-l-4 border-yellow-400">

            <div class="md:flex">

              <!-- Image -->
              <div class="md:w-1/3">
                <img
                  src="/<%= home.photo || 'https://placehold.co/400x300?text=No+Image' %>"
                  alt="<%= home.houseName || 'Home' %>"
                  class="w-full h-64 md:h-full object-cover"
                  onerror="this.onerror=null; this.src='https://placehold.co/400x300?text=No+Image'"
                >
              </div>

              <!-- Content -->
              <div class="p-6 md:w-2/3">

                <!-- Home & Status -->
                <div class="flex justify-between items-start mb-4">
                  <div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-1">
                      <%= home.houseName || 'Home no longer available' %>
                    </h3>
                    <p class="text-gray-600 flex items-center gap-1">
                      📍 <%= home.location || '' %>
                    </p>
                  </div>
                  <span class="px-4 py-2 bg-yellow-100 text-yellow-800 rounded-full text-sm font-bold">
                    ⏱ Awaiting Response
                  </span>
                </div>

                <!-- Guest Info Card -->
                <div class="bg-blue-50 p-4 rounded-lg mb-4">
                  <p class="text-xs text-blue-700 uppercase font-semibold mb-2">Booking from</p>
                  <p class="font-bold text-gray-900">
                    <%= guest.firstName || '' %> <%= guest.lastName || '' %>
                  </p>
                  <p class="text-sm text-gray-600"><%= guest.email || '' %></p>
                </div>

                <!-- Booking Details Grid -->
                <div class="grid grid-cols-2 md:grid-cols-5 gap-3 py-4 border-y border-gray-200 mb-4">

                  <div>
                    <p class="text-xs text-gray-600 uppercase font-semibold mb-1">Check-in</p>
                    <p class="font-semibold text-gray-900"><%= formatDate(booking.checkInDate) %></p>
                  </div>

                  <div>
                    <p class="text-xs text-gray-600 uppercase font-semibold mb-1">Check-out</p>
                    <p class="font-semibold text-gray-900"><%= formatDate(booking.checkOutDate) %></p>
                  </div>

                  <div>
                    <p class="text-xs text-gray-600 uppercase font-semibold mb-1">Nights</p>
                    <p class="font-semibold text-gray-900"><%= booking.numberOfNights %></p>
                  </div>

                  <div>
                    <p class="text-xs text-gray-600 uppercase font-semibold mb-1">Rate</p>
                    <p class="font-semibold text-gray-900">₹<%= booking.pricePerNight %>/night</p>
                  </div>

                  <div class="bg-gray-100 p-3 rounded-lg">
                    <p class="text-xs text-gray-600 uppercase font-semibold mb-1">Total Amount</p>
                    <p class="font-bold text-red-500 text-lg">₹<%= booking.totalPrice %></p>
                  </div>

                </div>

                <!-- Guest Message (if provided) -->
                <% if (booking.guestMessage) { %>
                  <div class="bg-amber-50 p-4 rounded-lg mb-4 border-l-4 border-amber-400">
                    <p class="text-xs text-amber-700 uppercase font-semibold mb-2">Guest Message</p>
                    <p class="text-sm text-amber-800">
                      "<%= booking.guestMessage %>"
                    </p>
                  </div>
                <% } %>

                <!-- Action Buttons -->
                <div class="flex gap-3 flex-wrap">

                  <!-- Approve Button -->
                  <form action="/host/bookings/<%= booking._id %>/approve" method="POST" class="inline">
                    <button
                      type="submit"
                      class="px-6 py-3 bg-green-500 text-white rounded-lg hover:bg-green-600 transition font-bold text-sm"
                    >
                      ✓ Approve
                    </button>
                  </form>

                  <!-- Reject Button -->
                  <button
                    type="button"
                    class="px-6 py-3 bg-red-500 text-white rounded-lg hover:bg-red-600 transition font-bold text-sm reject-btn"
                    data-booking-id="<%= booking._id %>"
                  >
                    ✕ Reject
                  </button>

                  <!-- View Home -->
                  <% if (home._id) { %>
                    <a
                      href="/homes/<%= home._id %>"
                      class="px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition font-bold text-sm"
                    >
                      View Home
                    </a>
                  <% } %>

                </div>

                <!-- Rejection Form (Hidden by default) -->
                <form
                  action="/host/bookings/<%= booking._id %>/reject"
                  method="POST"
                  class="reject-form hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-lg"
                  data-booking-id="<%= booking._id %>"
                >
                  <label class="block text-sm font-bold text-red-900 mb-3">
                    Why are you rejecting this booking? *
                  </label>
                  <textarea
                    name="rejectionReason"
                    maxlength="300"
                    rows="3"
                    placeholder="E.g., Dates not available, property under maintenance, etc."
                    class="w-full px-4 py-2 border border-red-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-red-500 mb-3"
                    required
                  ></textarea>
                  <div class="flex gap-3">
                    <button
                      type="submit"
                      class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition font-semibold text-sm"
                    >
                      Send Rejection
                    </button>
                    <button
                      type="button"
                      class="px-4 py-2 border border-red-300 text-red-700 rounded-lg hover:bg-red-100 transition font-semibold text-sm cancel-reject-btn"
                      data-booking-id="<%= booking._id %>"
                    >
                      Cancel
                    </button>
                  </div>
                </form>

              </div>

            </div>

          </div>

        <% }); %>

      </div>

    <% } %>

  </section>

  <!-- JavaScript for Reject Form Toggle (inside <body>) -->
  <script>
    function getRejectForm(bookingId) {
      return document.querySelector('.reject-form[data-booking-id="' + bookingId + '"]');
    }

    document.querySelectorAll('.reject-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const form = getRejectForm(this.getAttribute('data-booking-id'));
        if (form) form.classList.toggle('hidden');
      });
    });

    document.querySelectorAll('.cancel-reject-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const form = getRejectForm(this.getAttribute('data-booking-id'));
        if (form) form.classList.add('hidden');
      });
    });
  </script>

</body>
</html>
