<nav class="bg-white shadow-md px-8 py-4 flex justify-between items-center">

  <a href="/" class="text-3xl font-bold text-red-500 hover:text-red-600 transition">
    Stayora
  </a>

  <ul class="flex gap-6 items-center flex-wrap">

    <!-- Explore -->
    <li>
      <a href="/homes"
         class="<%= currentPage === 'explore' ? 'text-red-500 font-semibold' : 'text-gray-700 hover:text-red-500' %> transition">
        Explore
      </a>
    </li>

    <% if (isLoggedIn) { %>

      <% if (user.userType === "guest") { %>

        <!-- Guest Navigation -->
        <li>
          <a href="/my-bookings"
             class="<%= currentPage === 'myBookings' ? 'text-red-500 font-semibold' : 'text-gray-700 hover:text-red-500' %> transition flex items-center gap-1">
            📅 My Bookings
          </a>
        </li>

        <li>
          <a href="/favourites"
             class="<%= currentPage === 'favourites' ? 'text-red-500 font-semibold' : 'text-gray-700 hover:text-red-500' %> transition flex items-center gap-1">
            ❤️ Favourites
          </a>
        </li>

      <% } else if (user.userType === "host") { %>

        <!-- Host Navigation -->
        <li>
          <a href="/host/add-home"
             class="<%= currentPage === 'addHome' ? 'text-red-500 font-semibold' : 'text-gray-700 hover:text-red-500' %> transition">
            + Add Home
          </a>
        </li>

        <li>
          <a href="/host/hostHome"
             class="<%= currentPage === 'myHomes' ? 'text-red-500 font-semibold' : 'text-gray-700 hover:text-red-500' %> transition">
            My Homes
          </a>
        </li>

        <!-- Pending Bookings with Badge -->
        <li>
          <a href="/host/pending-bookings"
             class="<%= currentPage === 'pendingBookings' ? 'text-red-500 font-semibold' : 'text-gray-700 hover:text-red-500' %> transition flex items-center gap-2">
              Pending Bookings
          </a>
        </li>

        <li>
          <a href="/host/booking-history"
             class="<%= currentPage === 'bookingHistory' ? 'text-red-500 font-semibold' : 'text-gray-700 hover:text-red-500' %> transition">
            Booking History
          </a>
        </li>

      <% } %>

      <!-- Logout -->
      <li>
        <form action="/logout" method="POST" class="inline">
          <button type="submit" class="text-gray-700 hover:text-red-500 transition font-medium">
            Logout
          </button>
        </form>
      </li>

    <% } else { %>

      <!-- Not Logged In -->
      <li>
        <a href="/login"
           class="<%= currentPage === 'login' ? 'text-red-500 font-semibold' : 'text-gray-700 hover:text-red-500' %> transition">
          Login
        </a>
      </li>

      <li>
        <a href="/signup"
           class="<%= currentPage === 'signup' ? 'text-red-500 font-semibold' : 'text-gray-700 hover:text-red-500' %> transition">
          Sign Up
        </a>
      </li>

    <% } %>

  </ul>

</nav>
