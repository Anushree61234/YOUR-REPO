<!-- Search Bar Partial -->
<section style="max-width: 1100px; margin: 48px auto 32px; padding: 0 24px;">
  <form
    action="/"
    method="GET"
    style="display: flex; align-items: center; background: #fff; border: 1px solid #e5e7eb; border-radius: 9999px; box-shadow: 0 4px 14px rgba(0,0,0,0.08); padding: 8px; width: 100%; box-sizing: border-box;"
  >

    <!-- Location -->
    <div style="flex: 1; min-width: 0; padding: 4px 12px;">
      <label style="display: block; font-size: 12px; font-weight: 700; color: #111827;">Where</label>
      <input
        type="text"
        name="location"
        value="<%= filters.location %>"
        placeholder="Search destination"
        style="width: 100%; min-width: 0; font-size: 14px; color: #374151; background: transparent; border: none; outline: none;"
      >
    </div>

    <div style="width: 1px; height: 32px; background: #d1d5db; flex-shrink: 0;"></div>

    <!-- Check-in -->
    <div style="flex: 1; min-width: 0; padding: 4px 12px;">
      <label style="display: block; font-size: 12px; font-weight: 700; color: #111827;">Check-in</label>
      <input
        type="date"
        name="checkIn"
        value="<%= filters.checkIn %>"
        min="<%= today %>"
        style="width: 100%; min-width: 0; font-size: 14px; color: #374151; background: transparent; border: none; outline: none;"
      >
    </div>

    <div style="width: 1px; height: 32px; background: #d1d5db; flex-shrink: 0;"></div>

    <!-- Check-out -->
    <div style="flex: 1; min-width: 0; padding: 4px 12px;">
      <label style="display: block; font-size: 12px; font-weight: 700; color: #111827;">Check-out</label>
      <input
        type="date"
        name="checkOut"
        value="<%= filters.checkOut %>"
        min="<%= today %>"
        style="width: 100%; min-width: 0; font-size: 14px; color: #374151; background: transparent; border: none; outline: none;"
      >
    </div>

    <div style="width: 1px; height: 32px; background: #d1d5db; flex-shrink: 0;"></div>

    <!-- Min Price -->
    <div style="flex: 1; min-width: 0; padding: 4px 12px;">
      <label style="display: block; font-size: 12px; font-weight: 700; color: #111827;">Min ₹</label>
      <input
        type="number"
        name="minPrice"
        value="<%= filters.minPrice %>"
        min="0"
        placeholder="Any"
        style="width: 100%; min-width: 0; font-size: 14px; color: #374151; background: transparent; border: none; outline: none;"
      >
    </div>

    <div style="width: 1px; height: 32px; background: #d1d5db; flex-shrink: 0;"></div>

    <!-- Max Price -->
    <div style="flex: 1; min-width: 0; padding: 4px 12px;">
      <label style="display: block; font-size: 12px; font-weight: 700; color: #111827;">Max ₹</label>
      <input
        type="number"
        name="maxPrice"
        value="<%= filters.maxPrice %>"
        min="0"
        placeholder="Any"
        style="width: 100%; min-width: 0; font-size: 14px; color: #374151; background: transparent; border: none; outline: none;"
      >
    </div>

    <!-- Buttons -->
    <div style="display: flex; align-items: center; gap: 8px; padding-left: 8px; flex-shrink: 0;">
      <a
        href="/"
        style="padding: 8px; font-size: 14px; font-weight: 600; color: #374151; text-decoration: none; white-space: nowrap;"
      >
        Clear
      </a>
      <button
        type="submit"
        style="background-color: #ef4444; color: #fff; border: none; border-radius: 9999px; padding: 12px 24px; font-size: 14px; font-weight: 700; cursor: pointer; white-space: nowrap;"
      >
        Search
      </button>
    </div>

  </form>

  <% if (typeof dateError !== 'undefined' && dateError) { %>
    <p style="color: #ef4444; font-size: 14px; font-weight: 600; text-align: center; margin-top: 12px;"><%= dateError %></p>
  <% } %>
</section>