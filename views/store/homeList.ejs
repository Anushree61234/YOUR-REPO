<%- include("../partials/head") %>

<%- include("../partials/navbar") %>
<body class="bg-gray-100 min-h-screen">

  <!-- Page Header -->
  <section class="max-w-6xl mx-auto px-6 pt-10">

    <h1 class="text-4xl font-bold text-gray-900">
      Explore Homes
    </h1>

    <p class="text-gray-600 mt-2">
      Discover beautiful homes listed by our hosts and book your perfect stay.
    </p>

  </section>

  <!-- Homes Section -->
  <section class="max-w-6xl mx-auto px-6 py-8">

    <div class="flex justify-between items-center mb-6">

      <div>
        <h2 class="text-2xl font-bold">
          Available Homes
        </h2>

        <p class="text-gray-500 text-sm">
          Choose from our latest listings.
        </p>
      </div>

      <span class="bg-red-100 text-red-600 px-4 py-2 rounded-full font-semibold">
        <%= registeredHomes.length %> Home<%= registeredHomes.length === 1 ? '' : 's' %>
      </span>

    </div>

    <% if (registeredHomes.length === 0) { %>

      <div class="text-center py-16 bg-white rounded-xl shadow-lg">
        <p class="text-gray-500 text-lg">No homes available yet.</p>
      </div>

    <% } else { %>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

        <% registeredHomes.forEach((home) => { %>

          <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition">

            <img
              src="/<%= home.photo %>"
              alt="<%= home.houseName %>"
              class="w-full h-48 object-cover"
              onerror="this.src='https://placehold.co/400x300?text=No+Image'"
            >

            <div class="p-4">

              <h3 class="text-xl font-semibold mb-2">
                <%= home.houseName %>
              </h3>

              <p class="text-gray-500 mb-3">
                📍 <%= home.location %>
              </p>

              <p class="text-red-500 font-bold text-lg mb-4">
                ₹<%= home.price %>
                <span class="text-gray-500 font-normal text-sm">/ night</span>
              </p>

              <!-- Buttons -->
              <div style="display: flex; gap: 20px; margin-top: 16px;">

                <a
                  href="/homes/<%= home._id %>"
                  style="
                    display: block;
                    background-color: #3b82f6;
                    color: white;
                    padding: 10px 20px;
                    border-radius: 8px;
                    text-decoration: none;
                    font-weight: 600;
                  "
                >
                  View Details
                </a>

                <form
                  action="/favourites/delete/<%= home._id %>"
                  method="POST"
                  onsubmit="return confirm('Remove from favourites?');"
                >
                  <button
                    type="submit"
                    style="
                      background-color: #ef4444;
                      color: white;
                      padding: 10px 20px;
                      border-radius: 8px;
                      border: none;
                      font-weight: 600;
                      cursor: pointer;
                    "
                  >
                    Remove
                  </button>
                </form>

              </div>

            </div>

          </div>

        <% }) %>

      </div>

    <% } %>

  </section>

</body>
</html>