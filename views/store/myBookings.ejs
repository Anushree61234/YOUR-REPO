<%- include("../partials/head") %>

<%
  // Safe defaults so the template never crashes if a variable isn't passed
  const messageList = locals.messages || [];
  const bookingList = locals.bookings || [];

  // Status badge config (keeps long ternaries out of HTML attributes)
  const statusConfig = {
    approved:  { classes: 'bg-green-100 text-green-800',   label: '✓ Approved'  },
    pending:   { classes: 'bg-yellow-100 text-yellow-800', label: '⏱ Pending'   },
    rejected:  { classes: 'bg-red-100 text-red-800',       label: '✕ Rejected'  },
    cancelled: { classes: 'bg-gray-100 text-gray-800',     label: '✕ Cancelled' }
  };

  const formatDate = function (d) {
    return new Date(d).toLocaleDateString('en-IN', {
      day: '2-digit',
      month: 'short',
      year: 'numeric'
    });
  };
%>

<body class="bg-gray-100 min-h-screen">

  <%- include("../partials/navbar") %>

  <!-- Page Header -->
  <section class="max-w-6xl mx-auto px-6 pt-10 pb-6">
    <h1 class="text-4xl font-bold text-gray-900">My Bookings</h1>
    <p class="text-gray-600 mt-2">Track and manage all your reservations.</p>
  </section>

  <!-- Main Content -->
  <section class="max-w-6xl mx-auto px-6 pb-12">

    <!-- Success/Error Messages -->
    <% messageList.forEach(function (msg) {
         const isSuccess = msg.type === 'success';
         const msgClasses = isSuccess
           ? 'bg-green-50 border border-green-200 text-green-800'
           : 'bg-red-50 border border-red-200 text-red-800';
    %>
      <div class="mb-6 p-4 rounded-lg <%= msgClasses %>">
        <p class="font-semibold"><%= isSuccess ? '✓ Success' : '✕ Error' %></p>
        <p class="text-sm"><%= msg.text %></p>
      </div>
    <% }); %>

    <% if (bookingList.length === 0) { %>

      <!-- No Bookings -->
      <div class="bg-white rounded-xl shadow-lg p-12 text-center">
        <div class="text-5xl mb-4">📅</div>
        <h3 class="text-2xl font-bold text-gray-900 mb-2">No bookings yet</h3>
        <p class="text-gray-600 mb-6">Explore homes and book your next adventure!</p>
        <a href="/homes" class="inline-block bg-red-500 text-white px-6 py-3 rounded-lg hover:bg-red-600 transition font-semibold">
          Explore Homes
        </a>
      </div>

    <% } else { %>

      <!-- Bookings List -->
      <div class="space-y-6">

        <% bookingList.forEach(function (booking) {
             const home = booking.homeId || {};
             const host = booking.hostId || null;
             const status = statusConfig[booking.status] || statusConfig.cancelled;
             const canCancel = ['pending', 'approved'].includes(booking.status);
        %>

          <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition">

            <div class="md:flex">

              <!-- Image -->
              <div class="md:w-1/3">
                <img
                  src="/<%= home.photo || 'https://placehold.co/400x300?text=No+Image' %>"
                  alt="<%= home.houseName || 'Home' %>"
                  class="w-full h-64 md:h-full object-cover"
                  onerror="this.onerror=null; this.src='https://placehold.co/400x300?text=No+Image'"
                >
              </div>

              <!-- Content -->
              <div class="p-6 md:w-2/3">

                <div class="flex justify-between items-start mb-4">

                  <div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-1">
                      <%= home.houseName || 'Home no longer available' %>
                    </h3>
                    <p class="text-gray-600 flex items-center gap-1">
                      📍 <%= home.location || '' %>
                    </p>
                  </div>

                  <!-- Status Badge -->
                  <span class="inline-block px-4 py-2 rounded-full text-sm font-bold <%= status.classes %>">
                    <%= status.label %>
                  </span>

                </div>

                <!-- Booking Details Grid -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 py-4 border-y border-gray-200 mb-4">

                  <div>
                    <p class="text-xs text-gray-600 uppercase font-semibold mb-1">Check-in</p>
                    <p class="font-semibold text-gray-900"><%= formatDate(booking.checkInDate) %></p>
                  </div>

                  <div>
                    <p class="text-xs text-gray-600 uppercase font-semibold mb-1">Check-out</p>
                    <p class="font-semibold text-gray-900"><%= formatDate(booking.checkOutDate) %></p>
                  </div>

                  <div>
                    <p class="text-xs text-gray-600 uppercase font-semibold mb-1">Nights</p>
                    <p class="font-semibold text-gray-900"><%= booking.numberOfNights %></p>
                  </div>

                  <div>
                    <p class="text-xs text-gray-600 uppercase font-semibold mb-1">Total</p>
                    <p class="font-bold text-red-500 text-lg">₹<%= booking.totalPrice %></p>
                  </div>

                </div>

                <!-- Pricing Breakdown -->
                <div class="bg-gray-50 p-4 rounded-lg mb-4">
                  <div class="flex justify-between text-sm mb-2">
                    <span class="text-gray-600">₹<%= booking.pricePerNight %> × <%= booking.numberOfNights %> nights</span>
                    <span class="font-semibold">₹<%= booking.totalPrice %></span>
                  </div>
                </div>

                <!-- Host Info -->
                <% if (host) { %>
                  <div class="bg-blue-50 p-4 rounded-lg mb-4">
                    <p class="text-xs text-blue-700 uppercase font-semibold mb-1">Hosted by</p>
                    <p class="font-semibold text-gray-900">
                      <%= host.firstName %> <%= host.lastName %>
                    </p>
                    <p class="text-sm text-gray-600"><%= host.email %></p>
                  </div>
                <% } %>

                <!-- Guest Message -->
                <% if (booking.guestMessage) { %>
                  <div class="mb-4">
                    <p class="text-xs text-gray-600 uppercase font-semibold mb-2">Your Message</p>
                    <p class="text-sm text-gray-700 italic border-l-4 border-red-500 pl-3">
                      "<%= booking.guestMessage %>"
                    </p>
                  </div>
                <% } %>

                <!-- Rejection Reason (if rejected) -->
                <% if (booking.status === 'rejected' && booking.hostRejectReason) { %>
                  <div class="bg-red-50 p-4 rounded-lg mb-4 border border-red-200">
                    <p class="text-xs text-red-700 uppercase font-semibold mb-1">Rejection Reason</p>
                    <p class="text-sm text-red-700"><%= booking.hostRejectReason %></p>
                  </div>
                <% } %>

                <!-- Action Buttons -->
                <div class="flex gap-3 flex-wrap">

                  <% if (home._id) { %>
                    <a
                      href="/homes/<%= home._id %>"
                      class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition font-semibold text-sm"
                    >
                      View Home
                    </a>
                  <% } %>

                  <% if (canCancel) { %>
                    <form
                      action="/bookings/<%= booking._id %>/cancel"
                      method="POST"
                      class="inline"
                      onsubmit="return confirm('Are you sure you want to cancel this booking?');"
                    >
                      <button
                        type="submit"
                        class="px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition font-semibold text-sm"
                      >
                        Cancel Booking
                      </button>
                    </form>
                  <% } %>

                </div>

              </div>

            </div>

          </div>

        <% }); %>

      </div>

    <% } %>

  </section>

</body>
</html>
