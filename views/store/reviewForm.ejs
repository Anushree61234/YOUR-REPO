<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <title>Leave a Review</title>
</head>
<body class="bg-gray-50">
  <%- include('../partials/navbar') %>

  <div class="min-h-screen pt-20 pb-10 px-4">
    <div class="max-w-2xl mx-auto">
      
      <!-- Back Button -->
      <a href="/my-bookings" class="text-blue-500 hover:text-blue-700 mb-6 inline-block">
        ← Back to My Bookings
      </a>

      <div class="bg-white rounded-xl shadow-lg overflow-hidden">
        
        <!-- Home Preview -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 p-6 border-b border-gray-200">
          <div>
            <img src="/<%= booking.homeId.photo %>" alt="<%= booking.homeId.houseName %>" class="w-full h-40 object-cover rounded-lg">
          </div>
          <div class="md:col-span-2">
            <h2 class="text-2xl font-bold text-gray-800"><%= booking.homeId.houseName %></h2>
            <p class="text-gray-600 mt-2"><%= booking.homeId.location %></p>
            <p class="text-gray-700 mt-2"><strong>Check-in:</strong> <%= booking.checkInDate.toLocaleDateString() %></p>
            <p class="text-gray-700"><strong>Check-out:</strong> <%= booking.checkOutDate.toLocaleDateString() %></p>
          </div>
        </div>

        <!-- Review Form -->
        <div class="p-6">
          <h3 class="text-xl font-bold text-gray-800 mb-6">Leave Your Review</h3>

          <form action="/bookings/<%= booking._id %>/review" method="POST" class="space-y-6">
            
            <!-- Rating (1-5 Stars) -->
            <div>
              <label class="block text-lg font-semibold text-gray-800 mb-3">Rating</label>
              <div class="flex gap-4 text-4xl">
                <input type="radio" name="rating" value="1" id="star1" class="hidden peer">
                <label for="star1" class="cursor-pointer text-gray-300 hover:text-yellow-400 transition peer-checked:text-yellow-400">★</label>

                <input type="radio" name="rating" value="2" id="star2" class="hidden peer">
                <label for="star2" class="cursor-pointer text-gray-300 hover:text-yellow-400 transition peer-checked:text-yellow-400">★</label>

                <input type="radio" name="rating" value="3" id="star3" class="hidden peer">
                <label for="star3" class="cursor-pointer text-gray-300 hover:text-yellow-400 transition peer-checked:text-yellow-400">★</label>

                <input type="radio" name="rating" value="4" id="star4" class="hidden peer">
                <label for="star4" class="cursor-pointer text-gray-300 hover:text-yellow-400 transition peer-checked:text-yellow-400">★</label>

                <input type="radio" name="rating" value="5" id="star5" class="hidden peer">
                <label for="star5" class="cursor-pointer text-gray-300 hover:text-yellow-400 transition peer-checked:text-yellow-400">★</label>
              </div>
              <p class="text-red-500 text-sm mt-2" id="ratingError" style="display:none;">Please select a rating</p>
            </div>

            <!-- Comment -->
            <div>
              <label for="comment" class="block text-lg font-semibold text-gray-800 mb-3">Your Comment (Optional)</label>
              <textarea 
                name="comment" 
                id="comment"
                rows="5" 
                maxlength="500"
                placeholder="Share your experience with this home..."
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-red-500 focus:outline-none resize-none"
              ></textarea>
              <p class="text-gray-500 text-sm mt-1"><span id="charCount">0</span>/500 characters</p>
            </div>

            <!-- Submit Button -->
            <div class="flex gap-3">
              <button 
                type="submit" 
                class="flex-1 bg-red-500 hover:bg-red-600 text-white font-bold py-3 rounded-lg transition duration-200"
              >
                Submit Review
              </button>
              <a href="/my-bookings" class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-3 rounded-lg text-center transition duration-200">
                Cancel
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Character counter
    const textarea = document.getElementById('comment');
    const charCount = document.getElementById('charCount');
    textarea.addEventListener('input', () => {
      charCount.textContent = textarea.value.length;
    });

    // Validation
    document.querySelector('form').addEventListener('submit', (e) => {
      const rating = document.querySelector('input[name="rating"]:checked');
      if(!rating) {
        e.preventDefault();
        document.getElementById('ratingError').style.display = 'block';
      }
    });
  </script>
</body>
</html>