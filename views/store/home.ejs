<%- include("../partials/head") %>

<%- include("../partials/navbar") %>
<body class="bg-gray-100 min-h-screen">
  <!-- Hero -->
  <section class="text-center py-12 px-6">
    <h1 class="text-4xl font-bold mb-3">Find your next stay</h1>
    <p class="text-gray-600 mb-6">
      Browse homes listed by our hosts, or add your own.
    </p>

    <a
      href="/host/add-home"
      class="inline-block bg-red-500 text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-600 transition"
    >
      Add Your Home
    </a>
  </section>

  <!-- Registered Homes -->
  <section class="max-w-6xl mx-auto px-6 py-10">

    <h2 class="text-2xl font-bold mb-6">
      <%= registeredHomes.length %> home<%= registeredHomes.length === 1 ? '' : 's' %> available
    </h2>

    <% if (registeredHomes.length === 0) { %>

      <div class="text-center py-16 bg-white rounded-xl shadow-lg">
        <p class="text-gray-500 text-lg">No homes added yet.</p>
      </div>

    <% } else { %>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5">

        <% registeredHomes.forEach((home) => { %>

          <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition">

            <img
              src="/<%= home.photo %>"
              alt="<%= home.houseName %>"
              class="w-full h-32 object-cover"
              onerror="this.src='https://placehold.co/400x300?text=No+Image'"
            >

            <div class="p-3">

              <h3 class="text-base font-semibold mb-1 truncate">
                <%= home.houseName %>
              </h3>

              <p class="text-gray-500 text-xs mb-2">
                📍 <%= home.location %>
              </p>

              <p class="text-red-500 font-bold text-sm">
                ₹<%= home.price %>
                <span class="text-gray-500 font-normal text-xs">/ night</span>
              </p>

              <div class="text-center mt-3">
                <a
                  href="/reserve"
                  class="w-32 mx-auto flex justify-center bg-red-500 text-white py-2 rounded-lg text-sm font-medium hover:bg-red-600 transition"
                >
                  Book Now
                </a>
              </div>

            </div>

          </div>

        <% }) %>

      </div>

    <% } %>

  </section>

</body>
</html>