<%- include("../partials/head") %>

<body class="bg-gray-100 min-h-screen">

  <%- include("../partials/navbar") %>
  <%- include("../partials/searchBar") %>


  <!-- Registered Homes -->
  <section class="max-w-6xl mx-auto px-6 py-10">

    <h2 class="text-2xl font-bold mb-6">
      <%= registeredHomes.length %>
      home<%= registeredHomes.length === 1 ? "" : "s" %>
      available
    </h2>

    <% if (registeredHomes.length === 0) { %>

      <!-- No Homes Available -->
      <div class="text-center py-16 bg-white rounded-xl shadow-lg">
        <p class="text-gray-500 text-lg">
          No homes added yet.
        </p>
      </div>

    <% } else { %>

      <!-- Homes Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5">

        <% registeredHomes.forEach((home) => {
          const isFavourite = (favouriteIds || []).includes(
            home._id.toString()
          );
        %>

          <!-- Home Card -->
          <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition">

            <!-- Image Container -->
            <div class="relative">

              <img
                src="<%= home.photo || 'https://placehold.co/400x300?text=No+Image' %>"
                alt="<%= home.houseName || 'Home' %>"
                class="w-full h-40 object-cover"
                onerror="this.onerror=null; this.src='https://placehold.co/400x300?text=No+Image';"
              >

              <!-- Favourite Heart -->
              <% if (isFavourite) { %>

                <!-- Remove Favourite -->
                <form
                  action="/favourites/delete/<%= home._id %>"
                  method="POST"
                  class="absolute top-3 right-3 z-10"
                >
                  <input
                    type="hidden"
                    name="redirectTo"
                    value="/"
                  >

                  <button
                    type="submit"
                    aria-label="Remove from favourites"
                    title="Remove from favourites"
                    class="bg-black/20 rounded-full w-10 h-10 flex items-center justify-center hover:scale-110 transition"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      class="w-7 h-7"
                      fill="#ff385c"
                      stroke="white"
                      stroke-width="1.5"
                    >
                      <path
                        d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </button>
                </form>

              <% } else { %>

                <!-- Add Favourite -->
                <form
                  action="/favourites"
                  method="POST"
                  class="absolute top-3 right-3 z-10"
                >
                  <input
                    type="hidden"
                    name="id"
                    value="<%= home._id %>"
                  >

                  <input
                    type="hidden"
                    name="redirectTo"
                    value="/"
                  >

                  <button
                    type="submit"
                    aria-label="Add to favourites"
                    title="Add to favourites"
                    class="bg-black/20 rounded-full w-10 h-10 flex items-center justify-center hover:scale-110 transition"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      class="w-7 h-7"
                      fill="rgba(0,0,0,0.35)"
                      stroke="white"
                      stroke-width="1.8"
                    >
                      <path
                        d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </button>
                </form>

              <% } %>

            </div>

            <!-- Home Details -->
            <div class="p-3">

              <div class="flex justify-between items-start mb-1">
                <h3 class="text-base font-semibold truncate">
                  <%= home.houseName %>
                </h3>

                <span class="text-xs font-semibold text-gray-700 whitespace-nowrap ml-2">
                  <% if (home.rating && home.rating > 0) { %>
                    ★ <%= home.rating.toFixed(1) %>
                  <% } else { %>
                    New
                  <% } %>
                </span>
              </div>

              <p class="text-gray-500 text-xs mb-2">
                📍 <%= home.location %>
              </p>

              <p class="text-red-500 font-bold text-sm">
                ₹<%= home.price %>
                <span class="text-gray-500 font-normal text-xs">
                  / night
                </span>
              </p>

            </div>     

          </div>

        <% }) %>

      </div>

    <% } %>

  </section>

</body>
</html>